<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kadmin.mobile.mapper.MobileMomentPostMapper">
    <resultMap id="MobileMomentPostResultMap" type="com.kadmin.mobile.domain.MobileMomentPost">
        <id column="id" property="id"/>
        <result column="employee_id" property="employeeId"/>
        <result column="content" property="content"/>
        <result column="labels" property="labels"/>
        <result column="images" property="images"/>
        <result column="visibility" property="visibility"/>
        <result column="status" property="status"/>
        <result column="comment_count" property="commentCount"/>
        <result column="like_count" property="likeCount"/>
        <result column="created_time" property="createdTime"/>
        <result column="updated_time" property="updatedTime"/>
        <result column="created_by" property="createdBy"/>
        <result column="updated_by" property="updatedBy"/>
        <result column="author_name" property="authorName"/>
        <result column="author_avatar" property="authorAvatar"/>
        <result column="post" property="post"/>
        <result column="dept_name" property="deptName"/>
        <result column="liked" property="liked"/>
    </resultMap>

    <sql id="PostSelect">
        SELECT
            p.id,
            p.employee_id,
            p.content,
            p.labels,
            p.images,
            p.visibility,
            p.status,
            p.comment_count,
            p.like_count,
            p.created_time,
            p.updated_time,
            p.created_by,
            p.updated_by,
            e.name AS author_name,
            e.avatar AS author_avatar,
            e.post,
            u.unit_name AS dept_name,
            CASE WHEN l.id IS NULL THEN 0 ELSE 1 END AS liked
        FROM mobile_moment_post p
        LEFT JOIN hr_employee e ON p.employee_id = e.id
        LEFT JOIN org_unit u ON e.dept_id = u.id
        LEFT JOIN mobile_moment_like l
            ON l.post_id = p.id AND l.employee_id = #{viewerEmployeeId}
    </sql>

    <!-- 可见范围：visibility=1 公开；非公开仅作者本人可见 -->
    <sql id="VisibilityFilter">
        AND (p.visibility = 1 OR p.employee_id = #{viewerEmployeeId})
    </sql>

    <select id="selectPostPage" resultMap="MobileMomentPostResultMap">
        <include refid="PostSelect"/>
        WHERE p.status = 1
        <include refid="VisibilityFilter"/>
        <choose>
            <when test="tab == 'hot'">
                ORDER BY p.like_count DESC, p.comment_count DESC, p.created_time DESC
            </when>
            <when test="tab == 'recommend'">
                ORDER BY (p.like_count * 2 + p.comment_count * 3) DESC, p.created_time DESC
            </when>
            <otherwise>
                ORDER BY p.created_time DESC
            </otherwise>
        </choose>
    </select>

    <select id="selectPostDetail" resultMap="MobileMomentPostResultMap">
        <include refid="PostSelect"/>
        WHERE p.id = #{id}
          AND p.status = 1
          <include refid="VisibilityFilter"/>
        LIMIT 1
    </select>
</mapper>
