<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kadmin.mapper.EmployeeMapper">
    
    <!-- 员工结果映射 -->
    <resultMap id="EmployeeResultMap" type="com.kadmin.entity.HrEmployee">
        <id column="id" property="id"/>
        <result column="employee_no" property="employeeNo"/>
        <result column="name" property="name"/>
        <result column="avatar" property="avatar"/>
        <result column="id_card_front" property="idCardFront"/>
        <result column="id_card_back" property="idCardBack"/>
        <result column="gender" property="gender"/>
        <result column="highest_education" property="highestEducation"/>
        <result column="dept_id" property="deptId"/>
        <result column="nation" property="nation"/>
        <result column="id_card" property="idCard"/>
        <result column="birth_date" property="birthDate"/>
        <result column="phone" property="phone"/>
        <result column="email" property="email"/>
        <result column="employee_type" property="employeeType"/>
        <result column="entry_date" property="entryDate"/>
        <result column="regular_date" property="regularDate"/>
        <result column="duty" property="duty"/>
        <result column="position" property="position"/>
        <result column="post" property="post"/>
        <result column="job_function" property="jobFunction"/>
        <result column="job_level" property="jobLevel"/>
        <result column="job_responsibility" property="jobResponsibility"/>
        <result column="job_authority" property="jobAuthority"/>
        <result column="job_title" property="jobTitle"/>
        <result column="occupation" property="occupation"/>
        <result column="marital_status" property="maritalStatus"/>
        <result column="political_status" property="politicalStatus"/>
        <result column="native_place" property="nativePlace"/>
        <result column="police_station" property="policeStation"/>
        <result column="registered_address" property="registeredAddress"/>
        <result column="home_address" property="homeAddress"/>
        <result column="current_address" property="currentAddress"/>
        <result column="emergency_contact" property="emergencyContact"/>
        <result column="emergency_relation" property="emergencyRelation"/>
        <result column="emergency_phone" property="emergencyPhone"/>
        <result column="leave_date" property="leaveDate"/>
        <result column="status" property="status"/>
        <result column="deleted" property="deleted"/>
        <result column="created_time" property="createdTime"/>
        <result column="updated_time" property="updatedTime"/>
        <result column="dept_name" property="deptName"/>
        <result column="company_name" property="companyName"/>
        <result column="company_id" property="companyId"/>
    </resultMap>
    
    <!-- 分页查询员工列表（带公司和部门名称，使用统一组织架构表） -->
    <!-- 公司名称和ID通过dept_id向上查找公司(unit_type=2) -->
    <select id="selectPageWithDetails" resultMap="EmployeeResultMap">
        SELECT 
            e.id, e.employee_no, e.name, e.avatar, e.id_card_front, e.id_card_back,
            e.gender, e.highest_education, e.dept_id, e.nation, e.id_card, e.birth_date,
            e.phone, e.email, e.employee_type, e.entry_date, e.regular_date,
            e.duty, e.position, e.post, e.job_function, e.job_level, e.job_responsibility,
            e.job_authority, e.job_title, e.occupation, e.marital_status, e.political_status,
            e.native_place, e.police_station, e.registered_address, e.home_address,
            e.current_address, e.emergency_contact, e.emergency_relation, e.emergency_phone,
            e.leave_date, e.status, e.deleted, e.created_time, e.updated_time,
            d.unit_name as dept_name,
            CASE 
                WHEN d.unit_type = 2 THEN d.unit_name
                WHEN p1.unit_type = 2 THEN p1.unit_name
                WHEN p2.unit_type = 2 THEN p2.unit_name
                WHEN p3.unit_type = 2 THEN p3.unit_name
                ELSE NULL
            END as company_name,
            CASE 
                WHEN d.unit_type = 2 THEN d.id
                WHEN p1.unit_type = 2 THEN p1.id
                WHEN p2.unit_type = 2 THEN p2.id
                WHEN p3.unit_type = 2 THEN p3.id
                ELSE NULL
            END as company_id
        FROM hr_employee e
        LEFT JOIN org_unit d ON e.dept_id = d.id AND d.deleted = 0
        LEFT JOIN org_unit p1 ON d.parent_id = p1.id AND p1.deleted = 0
        LEFT JOIN org_unit p2 ON p1.parent_id = p2.id AND p2.deleted = 0
        LEFT JOIN org_unit p3 ON p2.parent_id = p3.id AND p3.deleted = 0
        ${ew.customSqlSegment}
    </select>
    
</mapper>
