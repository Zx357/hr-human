  "example": "<script lang=\"ts\" setup>\nimport { ref } from 'vue'\n\nconst inputValue = ref('')\n</script>\n\n<template>\n  <TnInput v-model=\"inputValue\" placeholder=\"请输入用户名\" />\n</template>"
