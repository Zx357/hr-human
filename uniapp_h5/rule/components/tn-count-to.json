    "font-size": "String",
    "decimals": "Number",
    "decimal-separator": "String",
    "thousands-separator": "String",
    "duration": "Number"
  },
  "events": [
    "end"
  ],
  "example": "<template>\n  <TnCountTo start=\"0\" end=\"100\" />\n</template>"
}