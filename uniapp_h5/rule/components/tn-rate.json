  "example": "<script lang=\"ts\" setup>\r\nimport { ref } from 'vue'\r\nconst rateValue = ref(0)\r\n</script>\r\n\r\n<template>\r\n  <TnRate v-model=\"rateValue\" />\r\n</template>"
