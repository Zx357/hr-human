    "size": "String | Number",
    "bold": "boolean",
    "transparent": "boolean",
    "transparent-bg": "String",
    "img-mode": [
      "scaleToFill",
      "aspectFit",
      "aspectFill",
      "widthFix",
      "heightFix",
      "top",
      "bottom",
      "center",
