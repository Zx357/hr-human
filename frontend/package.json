{
  "name": "kadmin-frontend",
  "type": "module",
  "version": "1.0.0",
  "description": "KAdmin 人力资源管理系统 PC 端，基于 Vue3、Vite7、TypeScript、ElementPlus 和 UnoCSS。",
  "author": {
    "name": "Soybean",
    "email": "soybeanjs@outlook.com",
    "url": "https://github.com/soybeanjs"
  },
  "license": "MIT",
  "homepage": "",
  "repository": {
    "url": ""
  },
  "bugs": {
    "url": ""
  },
  "keywords": [
    "kadmin",
    "hr-management",
