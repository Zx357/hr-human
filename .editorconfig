# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true

# Java 后端 - 4 空格缩进
[*.java]
indent_style = space
indent_size = 4

# XML / POM
[*.xml]
indent_style = space
indent_size = 4

# YAML
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# 前端代码 - 2 空格缩进
[*.{js,jsx,ts,tsx,vue,css,scss,less,json,html}]
indent_style = space
indent_size = 2

# Markdown
[*.md]
trim_trailing_whitespace = false
indent_style = space
indent_size = 2

# SQL
[*.sql]
indent_style = space
indent_size = 2

# Shell
[*.sh]
end_of_line = lf
indent_style = space
indent_size = 2
