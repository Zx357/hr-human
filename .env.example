# ========================================
# KAdmin 环境变量示例
# 复制为 .env（或在部署环境中导出为系统环境变量）后填入真实值
# .env 已被 .gitignore 忽略，不会进入版本库
# ========================================

# ---------- 后端：数据库 ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kadmin
DB_USERNAME=
DB_PASSWORD=

# ---------- 后端：Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- 后端：JWT ----------
# 生产环境必须设置为足够长的随机字符串，否则沿用配置文件里的占位默认值
JWT_SECRET=

# ---------- 前端 / uniapp：Google Maps ----------
# frontend/.env.dev、frontend/.env.prod 中的 VITE_GOOGLE_MAPS_API_KEY
# 以及 uniapp_h5/config.local.js、config.server.js 中的 googleMaps.apiKey
# 请替换 YOUR_GOOGLE_MAPS_API_KEY 为真实 Key
GOOGLE_MAPS_API_KEY=
